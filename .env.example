# Default provider: deepseek | openai | openai_compatible
LLM_PROVIDER=deepseek

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Custom OpenAI-compatible API (public HTTPS endpoint only)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=

# Bounded Agent Planner (LLM proposal + deterministic Policy Gate)
AGENT_PLANNER_ENABLED=true

# Optional LangSmith observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=growth-analysis-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Version metadata attached to traces and experiments
AGENT_PROMPT_VERSION=growth-sql-v2
